# Stable source package; see README.md before updating the release pin.
pkgname=dikte
pkgver=2.0.0
pkgrel=1
pkgdesc='Voice dictation with local or cloud transcription and cleanup'
arch=('any')
url='https://github.com/yusufipk/dikte'
license=('GPL-3.0-only')
depends=('python' 'python-pyqt6' 'ffmpeg' 'libpulse' 'hicolor-icon-theme')
makedepends=('desktop-file-utils')
checkdepends=('ttf-dejavu')
optdepends=(
  'qt6-wayland: native Wayland window support'
  'wl-clipboard: clipboard access on Wayland'
  'ydotool: automatic paste on Wayland (requires a configured daemon)'
  'xclip: clipboard access on X11'
  'xdotool: automatic paste on X11'
  'pipewire-pulse: PulseAudio-compatible audio server (or pulseaudio)'
  'pulseaudio: audio server (or pipewire-pulse)'
)
# Peeled v2.0.0 tag, not the replaceable latest prerelease.
_commit=b6a15fda93738d6c0f8556e09ea6c3ab62d3e113
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/yusufipk/dikte/tar.gz/$_commit"
        'dikte' 'dikte.desktop')
sha256sums=('ee3d37edce1a3b8e46c4cee61a080377b66681d27edfd3ce4612ff0226a318af'
            'e40d0bea5e09b616b1c2444451bf08b93d1d89b0e70e93ce3036b87fa5da350c' '3a3741311b4203388683755f08b9dee0cbcc28e2fd6ae77158a4287858c2adc2')

build() {
  cd "$srcdir/dikte-$_commit"
  QT_QPA_PLATFORM=offscreen python -m dikte.trayicon --hicolor "$srcdir/icons"
}

check() {
  desktop-file-validate "$srcdir/dikte.desktop"
  cd "$srcdir/dikte-$_commit"
  QT_QPA_PLATFORM=offscreen python -m unittest discover
}

package() {
  cd "$srcdir/dikte-$_commit"
  local site_packages
  site_packages=$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
  install -d "$pkgdir$site_packages/dikte"
  # Do not ship build-time bytecode, tests, or the personal installer.
  find dikte -type f ! -path '*/__pycache__/*' -exec \
    install -Dm644 '{}' "$pkgdir$site_packages/{}" \;
  python -m compileall -q -o 0 -o 1 -o 2 -s "$pkgdir" "$pkgdir$site_packages/dikte"
  install -Dm755 "$srcdir/dikte" "$pkgdir/usr/bin/dikte"
  install -Dm644 "$srcdir/dikte.desktop" "$pkgdir/usr/share/applications/dikte.desktop"
  install -d "$pkgdir/usr/share/icons"
  cp -r "$srcdir/icons/hicolor" "$pkgdir/usr/share/icons/"
  install -Dm644 README.md "$pkgdir/usr/share/doc/dikte/README.md"
}
